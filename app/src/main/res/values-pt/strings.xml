    <string name="about_text">Fiesta de Cartas reúne jogos tradicionais com arte original inspirada no baralho espanhol. Sem cadastro, sem contas: jogue, compartilhe e celebre.</string>
    <string name="version">Versão</string>
    <string name="select_language">Escolha seu idioma</string>
